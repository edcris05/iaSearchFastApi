# Copy this file to .env in each runtime clone and set real values.
# Do not commit real secrets.

OPENAI_API_KEY="<set-openai-api-key>"
PSQL_HOST="localhost"
PSQL_PORT=5432
PSQL_DBNAME="fastapiembeddings1"
PSQL_DB_USER="postgresql"
PSQL_DB_PASSWORD="<set-db-password>"

# Optional password aliases accepted by connector fallback chain.
# Leave empty unless your deployment uses one of these names.
PSQL_PASSWORD=""
PGPASSWORD=""
POSTGRES_PASSWORD=""

# Scope defaults (used when request omits context)
API_DEFAULT_PLATFORM="ecommerce"
API_DEFAULT_TENANT_ID="default"
API_DEFAULT_LOCALE="es"
API_DEFAULT_STORE_CODE="default"

# Intent extraction domain profile
# Allowed: generic | electronics
AI_DOMAIN_PROFILE="generic"

# Retrieval rerank configuration
RETRIEVAL_RERANK_VERSION="rerank_v1"
RETRIEVAL_RERANK_WEIGHTS='{"semantic":0.80,"margin":0.10,"business":0.10}'
RETRIEVAL_BUSINESS_BOOSTS='{}'

# Optional per-attribute threshold override (JSON)
# EMBEDDING_MIN_SIMILARITY_BY_ATTRIBUTE='{"color":0.50}'

# Scoped override examples (optional)
# RETRIEVAL_RERANK_WEIGHTS__MAGENTO__BASE__ES_AR__DEFAULT='{"semantic":0.82,"margin":0.08,"business":0.10}'
# RETRIEVAL_BUSINESS_BOOSTS__MAGENTO__BASE__ES_AR__DEFAULT='{"attr::promo":0.06}'

# Prompt and profile overrides (global + scoped)
# INTENT_SYSTEM_PROMPT="Eres un extractor de intención. Responde solo JSON válido."
# INTENT_PROMPT_TEMPLATE="Extrae intención y devuelve JSON con {user_query}."
# INTENT_DOMAIN_PROFILE="generic"
# INTENT_NUMERIC_FIELD_ALIASES='{"price_min":["price_from"],"price_max":["price_to"]}'

# Example tienda/canal override (platform/tenant/locale/store)
# INTENT_SYSTEM_PROMPT__ECOMMERCE__DEFAULT__ES__STORE_B2C="Eres un extractor para Store B2C. JSON estricto."
# INTENT_PROMPT_TEMPLATE__ECOMMERCE__DEFAULT__ES__STORE_B2C="Analiza: {user_query}. Devuelve JSON estricto."
# INTENT_DOMAIN_PROFILE__ECOMMERCE__DEFAULT__ES__STORE_B2C="electronics"
