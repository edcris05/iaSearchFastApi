# Copy this file to .env in each runtime clone and set real values.
# Do not commit real secrets.

OPENAI_API_KEY="<set-openai-api-key>"
PSQL_HOST="localhost"
PSQL_PORT=5432
PSQL_DBNAME="fastapiembeddings1"
PSQL_DB_USER="postgresql"
PSQL_DB_PASSWORD="<set-db-password>"

# Optional password aliases accepted by connector fallback chain.
# Leave empty unless your deployment uses one of these names.
PSQL_PASSWORD=""
PGPASSWORD=""
POSTGRES_PASSWORD=""

# Retrieval rerank configuration
RETRIEVAL_RERANK_VERSION="rerank_v1"
RETRIEVAL_RERANK_WEIGHTS='{"semantic":0.80,"margin":0.10,"business":0.10}'
RETRIEVAL_BUSINESS_BOOSTS='{}'

# Optional per-attribute threshold override (JSON)
# EMBEDDING_MIN_SIMILARITY_BY_ATTRIBUTE='{"color":0.50}'

# Scoped override examples (optional)
# RETRIEVAL_RERANK_WEIGHTS__MAGENTO__BASE__ES_AR__DEFAULT='{"semantic":0.82,"margin":0.08,"business":0.10}'
# RETRIEVAL_BUSINESS_BOOSTS__MAGENTO__BASE__ES_AR__DEFAULT='{"attr::promo":0.06}'
